{
  "tab_size": 2,
  "preferred_line_length": 120,
  "languages": {
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/vp",
          "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on",
      "tab_size": 2
    },
